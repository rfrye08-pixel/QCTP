{"schema":"qctp-day1-source-script-cue-part-v1","script_id":"QCTP-D1-SOURCE-LABELED-SCRIPT-CANDIDATE-REV0","part":2,"cues":[{"cue_id":"D1-A02-180","start_seconds":180,"phase":"Heart Coherence","source_id":"HM-QC-01","source_operation_id":"HEART_FOCUS","practice_class":"SOURCE_ENHANCED","fidelity_status":"DIRECTLY SOURCE-DERIVED","spoken_text":"Place your attention in the area of the heart. Imagine that the breath is moving in and out through the heart or the center of the chest.","target_wpm":102,"max_duration_seconds":18,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-VOICE-TEACH","E-SAFETY"],"delivery_notes":"","word_count":27,"estimated_duration_seconds":15.88,"text_sha256":"1dcc6c1d772e3ad540bb5cd35cba480b553a1ee10761ab2649f204e45bf429eb","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":210,"available_window_seconds":30},{"cue_id":"D1-A02-210","start_seconds":210,"phase":"Heart Coherence","source_id":"HM-QC-01","source_operation_id":"FIVE_FIVE_BREATH_ENTRY","practice_class":"SOURCE_ENHANCED","fidelity_status":"DIRECTLY SOURCE-DERIVED","spoken_text":"Begin an easy, even breath. In for five: one, two, three, four, five. Out for five: one, two, three, four, five.","target_wpm":92,"max_duration_seconds":18,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-BREATH-RAIL","E-VOICE-TEACH","E-SAFETY"],"delivery_notes":"Count is paced in real time. Quiet breath rail begins beneath the final count.","word_count":21,"estimated_duration_seconds":13.7,"text_sha256":"eb5a9271377d27b27ce0cf819664e0655c4bfbaa9ca8be14d41b0a7259e6f419","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":245,"available_window_seconds":35},{"cue_id":"D1-A02-245","start_seconds":245,"phase":"Heart Coherence","source_id":"HM-QC-01","source_operation_id":"COMFORT_OVERRIDE","practice_class":"SOURCE_ENHANCED","fidelity_status":"SOURCE-COMPATIBLE CLA