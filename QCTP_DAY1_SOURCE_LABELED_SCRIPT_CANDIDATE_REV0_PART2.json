ration_seconds":15.63,"text_sha256":"17369beec44388f9b54775ac1ece13b935e29a76f124b4f44e2c5ee98d24d03c","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":385,"available_window_seconds":50},{"cue_id":"D1-A02-385","start_seconds":385,"phase":"Heart Coherence","source_id":"HM-QC-01","source_operation_id":"ALTERNATIVE_FEELING","practice_class":"SOURCE_ENHANCED","fidelity_status":"DIRECTLY SOURCE-DERIVED","spoken_text":"If appreciation does not come easily, use care, calm, or ease. Continue breathing through the heart area while you sustain the most genuine quality available.","target_wpm":95,"max_duration_seconds":20,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-BREATH-RAIL","E-VOICE-TEACH","E-SAFETY"],"delivery_notes":"","word_count":25,"estimated_duration_seconds":15.79,"text_sha256":"607930281e41edff7cc75f87b84b2b36e9fa9bf1aaf36869f3973f6947ba3b57","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":435,"available_window_seconds":50},{"cue_id":"D1-A02-435","start_seconds":435,"phase":"Heart Coherence","source_id":"HM-QC-01","source_operation_id":"STABILIZE_COHERENCE","practice_class":"SOURCE_ENHANCED","fidelity_status":"SOURCE-COMPATIBLE CLARIFICATION","spoken_text":"For the next few breaths, let the heart focus, the even rhythm, and the feeling operate together. Notice any change in the body or the quality of attention.","target_wpm":92,"max_duration_seconds":21,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-BREATH-RAIL","E-VOICE-TEACH"],"delivery_notes":"","word_count":28,"estimated_duration_seconds":18.26,"text_sha256":"cb5a60724a5a48e38a1a8dadb5ef7bcdf376f30b2211b12fdbae9b3e603b2214","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":462,"available_window_seconds":27},{"cue_id":"D1-A02-462","start_seconds":462,"phase":"Source Transition","source_id":"QCTP-TRANSITION-01","source_operation_id":"HEARTMATH_TO_DISPENZA","practice_class":"QCTP_SYNTHESIS","fidelity_status":"QCTP SYNTHESIS TRANSITION","spoken_text":"Let the breath return to its own rhythm. Keep the steadier feeling if it remains. Now the practice shifts from heart coherence to spatial attention.","target_wpm":101,"max_duration_seconds":18,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-TRANSITION","E-AUDIO-CONTINUOUS"],"delivery_notes":"","word_count":25,"estimated_duration_seconds":14.85,"text_sha256":"198ab654dd3e8aab0adef13c3d19b6b56978a44cba5c2d567e439bfd1d67b58e","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":480,"available_window_seconds":18}]}