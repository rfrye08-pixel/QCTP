# Illustrative QCTP PX13 gateway configuration. This file contains no secrets.
# The current npm server command reads process environment variables; export
# these in the operator shell or use an approved local secret launcher.

NODE_ENV=development
PORT=8787

# Required single-user QCTP pairing token: exactly 32 random bytes encoded as
# 64 hex characters. In PowerShell, generate it with:
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLowerInvariant()
# The deliberately invalid placeholder below must be replaced. Never commit or
# place the real value in a URL.
QCTP_API_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Free Local Mode is the controlled default.
QCTP_TRANSCRIPTION_PROVIDER=local
QCTP_LOCAL_WHISPER_URL=http://127.0.0.1:8788/v1/audio/transcriptions
QCTP_LOCAL_WHISPER_MODEL=base
QCTP_LOCAL_WHISPER_HIGH_ACCURACY_MODEL=small
QCTP_TRANSCRIPTION_MAX_BYTES=26214400
QCTP_TRANSCRIPTION_MAX_DURATION_MS=1200000
QCTP_TRANSCRIPTION_RATE_LIMIT=30
QCTP_TRANSCRIPTION_RATE_WINDOW_MS=3600000

# Full generative Mirror inference remains on loopback inside the PX13.
QCTP_MIRROR_OLLAMA_URL=http://127.0.0.1:11434
QCTP_MIRROR_MODEL=qwen3:8b
QCTP_MIRROR_POLL_INTERVAL_MS=2000
QCTP_MIRROR_RATE_LIMIT=1000
QCTP_MIRROR_RATE_WINDOW_MS=3600000

# Optional override. Prefer the default private OS application-data location:
# %LOCALAPPDATA%\QCTP\mirror-jobs.json on Windows. Do not point this into the
# repository, dist directory, or another web-served directory.
# QCTP_MIRROR_JOB_STORE_PATH=C:\private-qctp-data\mirror-jobs.json

# Paid cloud is intentionally off. OPENAI_API_KEY is not required in Free Local
# Mode and is deliberately absent from this example.
QCTP_ENABLE_PAID_CLOUD=false
QCTP_PAID_CLOUD_HARD_SPEND_LIMIT_USD=0