{"schema":"qctp-day1-source-script-cue-part-v1","script_id":"QCTP-D1-SOURCE-LABELED-SCRIPT-CANDIDATE-REV0","part":3,"cues":[{"cue_id":"D1-A02-480","start_seconds":480,"phase":"Spatial Induction","source_id":"JD-SPACE-01","source_operation_id":"BODY_AREA_IN_SPACE","practice_class":"SOURCE_ENHANCED","fidelity_status":"DIRECTLY SOURCE-DERIVED","spoken_text":"Bring awareness to the region between your ears. Sense the volume this region occupies. Do not analyze it. Feel that area as existing within space.","target_wpm":96,"max_duration_seconds":19,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-VOICE-TEACH","E-SAFETY"],"delivery_notes":"","word_count":25,"estimated_duration_seconds":15.63,"text_sha256":"dff4b4ab5572fe9ab6ba0f7dab00e7711b30172453eefa9ad2c4bd032953553e","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":525,"available_window_seconds":45},{"cue_id":"D1-A02-525","start_seconds":525,"phase":"Spatial Induction","source_id":"JD-SPACE-01","source_operation_id":"SPACE_AROUND_HEAD","practice_class":"SOURCE_ENHANCED","fidelity_status":"DIRECTLY SOURCE-DERIVED","spoken_text":"Now include the space immediately surrounding the head. Let attention become less like a point aimed at an object and more like a field around it.","target_wpm":93,"max_duration_seconds":19,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-VOICE-TEACH"],"delivery_notes":"","word_count":26,"estimated_duration_seconds":16.77,"text_sha256":"2eecc2d9199d96c2137c4b1bcd784b41b6966d05465cbe9e6ed6e9cf7f1c1222","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":575,"available_window_seconds":50},{"cue_id":"D1-A02-575","start_seconds":575,"phase":"Spatial Induction","source_id":"JD-SPACE-01","source_operation_id":"COMPARE_NARROW_AND_BROAD","practice_class":"SOURCE_ENHANCED","fidelity_status":"SOURCE-COMPATIBLE CLARIFICATION","spoken_text":"Notice the contrast. Narrow attention selects a thing. Broad attention receives the space around the thing. You do not need to picture a scene.","target_wpm":92,"max_duration_seconds":19,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-VOICE-TEACH","E-SAFETY"],"delivery_notes":"","word_count":24,"estimated_duration_seconds":15.65,"text_sha256":"53fecde736ca850106b47c6f3f07aa725797251186a22c31e8f594901f710f50","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":635,"available_window_seconds":60},{"cue_id":"D1-A02-635","start_seconds":635,"phase":"Spatial Induction","source_id":"JD-SPACE-01","source_operation_id":"TORSO_AREA_AND_SPACE","practice_class":"SOURCE_ENHANCED","fidelity_status":"SOURCE-COMPATIBLE CLARIFICATION","spoken_text":"Include the chest and abdomen as one volume. Then sense the space around that volume: in front, behind, and to both sides.","target_wpm":92,"max_duration_seconds":18,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-VOICE-TEACH"],"delivery_notes":"","word_count":22,"estimated_duration_seconds":14.35,"text_sha256":"7f8928f6d78ab24a45f62551d684ca5a512b94f0312cadf65386c1a91c37c936","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":700,"available_window_seconds":65},{"cue_id":"D1-A02-700","start_seconds":700,"phase":"Spatial Induction","source_id":"JD-SPACE-01","source_operation_id":"WHOLE_BODY_VOLUME","practice_class":"SOURCE_ENHANCED","fidelity_status":"SOURCE-COMPATIBLE CLARIFICATION","spoken_text":"Let the whole body become one volume in awareness. Sense where it occupies space without tracing every body part.","target_wpm":90,"max_duration_seconds":15,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-VOICE-TEACH"],"delivery_notes":"","word_count":19,"estimated_duration_seconds":12.67,"text_sha256":"6d9a4eadba61a831216a46322685aa34b7494b60dc78a329380465157b38a9ce","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":750,"available_window_seconds":50},{"cue_id":"D1-A02-750","start_seconds":750,"phase":"Source Transition","source_id":"QCTP-TRANSITION-01","source_operation_id":"INDUCTION_TO_OPEN_SPACE","practice_class":"QCTP_SYNTHESIS","fidelity_status":"QCTP SYNTHESIS TRANSITION","spoken_text":"Keep the body included, and now give more attention to the space surrounding it. The next phase uses less effort and fewer words.","target_wpm":94,"max_duration_seconds":17,"qctp_enhancement_ids":["E-AUDIO-PRECUE","E-TRANSITION","E-AUDIO-CONTINUOUS"],"delivery_notes":"","word_count":23,"estimated_duration_seconds":14.68,"text_sha256":"4b7c55182be2defada4568c7103f4579ab7e551baf93f923e07d0cf616c7320a","pre_cue_marker":true,"support_bed":"continuous_required","binaural_support":"optional_qctp_support_unlocked","next_cue_start_seconds":780,"available_window_seconds":30}]}